{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny"
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "instructions/INSTRUCTIONS.md",
    "skills/eval-harness/SKILL.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\Users\\wuchaoli\\.codex\\scripts\\github-mcp.ps1"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "npx -y @modelcontextprotocol/server-postgres \"$POSTGRES_URL\""
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "npm *": "ask",
      "yarn *": "ask",
      "pnpm *": "ask",
      "pip *": "ask",
      "git push *": "ask",
      "git branch -D *": "ask",
      "git tag -d *": "ask",
      "git remote remove *": "ask",
      "git reset --hard *": "ask"
    },
    "external_directory": {
      "~/.config/opencode/*": "allow"
    },
    "mcp_*": "allow"
  },
  "plugin": [
    "./plugins"
  ],
  "skills": {},
  "provider": {
    "tabcode": {
      "models": {
        "gpt-5.3-codex": {
          "name": "gpt-5.3-codex",
          "family": "gpt-codex",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 512000,
            "input": 512000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        },
        "gpt-5.4": {
          "name": "gpt-5.4",
          "family": "gpt",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "limit": {
            "context": 1000000,
            "input": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
          }
        }
      },
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "",
        "baseURL": "https://api2.tabcode.cc/openai/v1",
        "timeout": 300000
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/anthropic",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "",
        "setCacheKey": true
      },
      "models": {
        "anthropic/claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6"
        },
        "anthropic/claude-opus-4.7": {
          "name": "Claude Opus 4.7"
        }
      }
    }
  }
}